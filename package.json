{
  "name": "crunchyroll-censoring",
  "version": "0.1.10",
  "description": "Local, caption-timed English profanity filtering for supported Crunchyroll players.",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "node scripts/build.mjs && npm run validate",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/unit/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "validate": "node scripts/validate.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "verify": "npm run check && npm run test:e2e",
    "package": "npm run build && node scripts/package.mjs",
    "release": "npm run verify && npm run package",
    "release:store": "npm run release && node scripts/package-store.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/chrome": "0.3.7",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
