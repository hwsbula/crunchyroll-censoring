{
  "manifest_version": 3,
  "name": "CrunchyRoll Censoring",
  "version": "0.1.9",
  "description": "Independent English profanity filter for Crunchyroll captions and matching English-dub CC audio. Coverage varies.",
  "minimum_chrome_version": "120",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CrunchyRoll Censoring",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'; frame-src 'none'; form-action 'none'"
  },
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://static.crunchyroll.com/vilos-v2/web/vilos/player.html*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/vilos-v2/web/vilos/player.html*"
      ],
      "js": ["player.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*",
        "https://static.crunchyroll.com/vilos-v2/web/vilos/player.html*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
